{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(bash:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(supabase:*)",
      "Bash(vercel:*)",
      "Bash(npx:*)",
      "Bash(turbo:*)",
      "Bash(playwright:*)",
      "Bash(vitest:*)",
      "Edit(**/*.ts)",
      "Edit(**/*.tsx)",
      "Edit(**/*.js)",
      "Edit(**/*.jsx)",
      "Edit(**/*.json)",
      "Edit(**/*.md)",
      "Edit(**/*.yaml)",
      "Edit(**/*.yml)",
      "Edit(**/*.sql)",
      "Edit(**/*.css)",
      "Edit(**/*.html)",
      "Edit(**/*.sh)",
      "Edit(**/*.py)",
      "Edit(**/.env.example)",
      "Edit(**/.gitignore)",
      "Edit(**/STATUS.md)",
      "Edit(**/DECISIONS.md)",
      "Edit(**/BLOCKERS.md)",
      "Edit(**/TASKS.md)",
      "Read(**/*)",
      "Glob(**/*)",
      "Grep(**/*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(:(){ :|:& };::*)",
      "Bash(*sudo rm*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/agents/**)",
      "Edit(**/.claude/skills/**)",
      "Edit(**/.claude/commands/**)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/scripts/**)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-identity-pin.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-briefing.sh" }
      ]}
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/userprompt-context-refresh.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/userprompt-todo-reminder.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/userprompt-reviewer-trigger.sh" }
      ]}
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash-escalation-block.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash-head-drift.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secret-body.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/block-prod-destructive.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash-migration-slot.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash-test-pre-push.sh" }
      ]},
      { "matcher": "Edit", "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-edit-plugin-files.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-edit-monorepo-boundary.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-edit-secret-body.sh" }
      ]},
      { "matcher": "Write", "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-edit-plugin-files.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-edit-monorepo-boundary.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-edit-secret-body.sh" }
      ]}
    ],
    "PostToolUse": [
      { "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/escalation-counter.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/posttooluse-status-refresh.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/notification-trigger.sh" }
      ]},
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-bash-head-record.sh" }
      ]},
      { "matcher": "Edit|Write", "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/posttooluse-decision-markup.sh" }
      ]}
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-handoff-comment.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-completeness.sh" }
      ]}
    ],
    "PreCommit": [
      { "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/gitleaks-precommit.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/precommit-ticket-id-required.sh" }
      ]}
    ],
    "PrePush": [
      { "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-branch-fresh.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-push-tests.sh" }
      ]}
    ]
  }
}
