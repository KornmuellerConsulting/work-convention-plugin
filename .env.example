# =============================================================================
# work-convention-plugin — Umgebungsvariablen-Template (v2.0)
# =============================================================================
# Kopier diese Datei zu .env in deiner App und füll die Werte aus.
# Niemals .env committen. Ist in .gitignore.
#
# v2.0-Prinzip: so wenig wie möglich. Alles hier ist entweder Identity
# (wer arbeitet, welche App) oder optionales Layer-3-Notify. ClickUp-,
# Status- und Advisor-Konfiguration sind mit v2.0 ersatzlos entfallen.
# =============================================================================

# -----------------------------------------------------------------------------
# IDENTITY
# -----------------------------------------------------------------------------
# APP_PROJECT_PREFIX ist doppelt wichtig:
#   1. Ticket-Prefix fürs Commit-Format: feat(<PREFIX>-<nr>): ...
#   2. Empire-App-Marker: session-start-ensure-git-hooks.sh installiert die
#      git-Hooks (Ticket-ID-Zwang, gitleaks, Pre-Push-Tests) NUR in Repos,
#      deren .env diesen Key gesetzt hat. Ohne ihn fasst das Plugin fremde
#      Repos nie an.
APP_NAME="example-web"
APP_PROJECT_PREFIX="EXAMPLE"

# Wer redet gerade mit Claude Code? Wert: "patrick" oder "justin".
# Gelesen vom Migrations-Slot-Lock (verhindert parallele DB-Migrationen).
CURRENT_OPERATOR="patrick"

# -----------------------------------------------------------------------------
# LAYER-3-NOTIFY (optional — nur für /escalate 3)
# -----------------------------------------------------------------------------
# Wird ausschließlich von scripts/notify.sh gelesen, das nur bei manueller
# Layer-3-Eskalation läuft. Leer lassen = /escalate 3 meldet sich nur lokal.
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_BLOCKERS="empire-blockers"
SLACK_USER_PATRICK=""
SLACK_USER_JUSTIN=""

PUSHOVER_APP_TOKEN=""
PUSHOVER_USER_PATRICK=""
PUSHOVER_USER_JUSTIN=""

CALLMEBOT_PHONE_PATRICK=""
CALLMEBOT_APIKEY_PATRICK=""
CALLMEBOT_PHONE_JUSTIN=""
CALLMEBOT_APIKEY_JUSTIN=""
