# =============================================================================
# work-convention-plugin — Umgebungsvariablen-Template
# =============================================================================
# Kopier diese Datei zu .env in deiner App und füll die Werte aus.
# Niemals .env committen. Ist in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# IDENTITY
# -----------------------------------------------------------------------------
# Welche App ist das? Setzt Project-Prefix für ClickUp-Tasks.
APP_NAME="example-web"
APP_PROJECT_PREFIX="EXAMPLE"
APP_DOMAIN="example-web.localhost"

# Welche Person redet aktuell mit Claude Code?
# Wert: "patrick" oder "justin"
# Wird von session-start-identity-pin.sh gelesen.
CURRENT_OPERATOR="patrick"

# -----------------------------------------------------------------------------
# GITHUB
# -----------------------------------------------------------------------------
GITHUB_ORG="KornmuellerConsulting"
GITHUB_MONOREPO="apps"
GITHUB_PAT=""

# -----------------------------------------------------------------------------
# CLICKUP
# -----------------------------------------------------------------------------
CLICKUP_API_TOKEN=""
CLICKUP_TEAM_ID=""
CLICKUP_SPACE_ID=""
CLICKUP_TASKS_LIST_ID=""

# Custom-Field-IDs (werden via bootstrap-clickup-fields.py einmalig erstellt)
CLICKUP_FIELD_LAYER_ID=""
CLICKUP_FIELD_ESCALATION_COUNT_ID=""
CLICKUP_FIELD_GITHUB_PR_ID=""
CLICKUP_FIELD_DEPLOYMENT_ENV_ID=""
CLICKUP_FIELD_DECISION_BLOCK_ID=""

# -----------------------------------------------------------------------------
# SLACK
# -----------------------------------------------------------------------------
# Bot-Token statt Incoming-Webhooks (Audit-Fix #5)
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_STATUS="empire-status"
SLACK_CHANNEL_BLOCKERS="empire-blockers"
SLACK_CHANNEL_APP_BUILD="example-web-build"

# Slack-User-IDs für Mentions bei Layer-3
SLACK_USER_PATRICK=""
SLACK_USER_JUSTIN=""

# -----------------------------------------------------------------------------
# PUSHOVER (iOS Push)
# -----------------------------------------------------------------------------
PUSHOVER_APP_TOKEN=""
PUSHOVER_USER_PATRICK=""
PUSHOVER_USER_JUSTIN=""

# -----------------------------------------------------------------------------
# WHATSAPP (CallMeBot)
# -----------------------------------------------------------------------------
CALLMEBOT_PHONE_PATRICK=""
CALLMEBOT_APIKEY_PATRICK=""
CALLMEBOT_PHONE_JUSTIN=""
CALLMEBOT_APIKEY_JUSTIN=""

# -----------------------------------------------------------------------------
# VERCEL
# -----------------------------------------------------------------------------
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""

# -----------------------------------------------------------------------------
# SUPABASE (optional je App)
# -----------------------------------------------------------------------------
SUPABASE_PROJECT_REF_STAGE=""
SUPABASE_PROJECT_REF_PROD=""
SUPABASE_ACCESS_TOKEN=""
SUPABASE_DB_PASSWORD_STAGE=""
SUPABASE_DB_PASSWORD_PROD=""

# -----------------------------------------------------------------------------
# ANTHROPIC (optional je App)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=""

# -----------------------------------------------------------------------------
# PLUGIN-AUDIT
# -----------------------------------------------------------------------------
LAST_PLUGIN_AUDIT_TIMESTAMP=""

# -----------------------------------------------------------------------------
# DASHBOARD (GitHub-Pages)
# -----------------------------------------------------------------------------
DASHBOARD_REPO="KornmuellerConsulting/apps"
DASHBOARD_BRANCH="gh-pages"
